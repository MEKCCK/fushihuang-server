#!/usr/bin/env bash
# ============================================================
#  大一统服务端 进程管理器
#  用法:
#    scripts/unified-server start [service]
#    scripts/unified-server stop  [service]
#    scripts/unified-server restart [service]
#    scripts/unified-server status
#    scripts/unified-server logs <service> [lines]
#   service: psp-adhocctl | psp-postoffice | azahar-room | eden-room | webui | all
# ============================================================
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# 可被管理面板/外部通过环境变量覆盖
UNIFIED_ROOT="${UNIFIED_ROOT:-$ROOT}"

CONF="${UNIFIED_ROOT}/config/unified-server.conf"
[ -f "$CONF" ] || { echo "config not found: $CONF"; exit 1; }

# 安全解析 key=value 配置(不能用 bash source:含空格的中文值会被当成命令执行)
# 支持注释(#开头)、空行;值保留内部空格,去除首尾空白与引号
parse_conf() {
    while IFS= read -r line; do
        line=${line%%$'\r'}
        case "$line" in
            ''|'#'*) continue ;;
        esac
        key="${line%%=*}"; value="${line#*=}"
        [ -n "$key" ] || continue
        case "$key" in
            *[!A-Za-z0-9_]*|'') continue ;;
        esac
        # 去除值首尾空白与成对引号
        value="${value#" "}"; value="${value%" "}"
        while [ ${#value} -ge 2 ] && { [ "${value:0:1}" = '"' ] || [ "${value:0:1}" = "'" ]; }; do
            q="${value:0:1}"
            [ "${value: -1}" = "$q" ] || break
            value="${value:1:${#value}-2}"
        done
        printf -v "$key" '%s' "$value"
    done < "$CONF"
}
parse_conf

RUN_DIR="$UNIFIED_ROOT/data/run"
LOG_DIR="$UNIFIED_ROOT/data/logs"
DATA_DIR="$UNIFIED_ROOT/data"
mkdir -p "$RUN_DIR" "$LOG_DIR" "$DATA_DIR"

# 兼容源码目录(build/bin)与发布包(bin)两种布局
if [ -z "${BIN_DIR:-}" ]; then
    if [ -d "$UNIFIED_ROOT/build/bin" ]; then BIN_DIR="$UNIFIED_ROOT/build/bin"
    elif [ -d "$UNIFIED_ROOT/bin" ]; then BIN_DIR="$UNIFIED_ROOT/bin"
    else BIN_DIR="$UNIFIED_ROOT/build/bin"; fi
fi
NODE_BIN="${NODE_BIN:-$(command -v node || echo "$UNIFIED_ROOT/runtime/node/bin/node")}"

[ -x "$NODE_BIN" ] || NODE_BIN="$(command -v node)"

SERVICES="psp-adhocctl psp-postoffice azahar-room eden-room webui"

pid_file()   { echo "$RUN_DIR/$1.pid"; }
log_file()   { echo "$LOG_DIR/$1.log"; }

# 清理游离进程(手动启动/未记录 pid 的残留),避免端口占用导致新进程绑定失败
kill_free() {
    case "$1" in
        psp-adhocctl)   pkill -9 -f '[p]spnet_adhocctl_server' 2>/dev/null ;;
        psp-postoffice) pkill -9 -f '[a]emu_postoffice.js' 2>/dev/null ;;
        azahar-room)    pkill -9 -f '[/]bin/azahar-room' 2>/dev/null ;;
        eden-room)      pkill -9 -f '[/]bin/eden-room' 2>/dev/null ;;
        webui)          pkill -9 -f '[w]ebui/server.js' 2>/dev/null ;;
    esac
    return 0
}

is_running() {
    [ -f "$(pid_file "$1")" ] || return 1
    pid="$(cat "$(pid_file "$1")" 2>/dev/null)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

tcp_up() {
    local port="$1"
    timeout 1 bash -c "exec 3<>/dev/tcp/127.0.0.1/$port" 2>/dev/null
}

# UDP 探测(房间服务器走 ENet/UDP,没有 TCP 监听;无 ICMP 拒绝即视为在线)
udp_up() {
    local port="$1"
    python3 - "$port" <<'PYEOF'
import socket, sys
port = int(sys.argv[1])
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
s.settimeout(1.0)
try:
    s.sendto(b"\x00" * 32, ("127.0.0.1", port))
    try:
        s.recvfrom(64)
    except socket.timeout:
        pass
    except ConnectionRefusedError:
        sys.exit(1)
except OSError:
    sys.exit(1)
finally:
    s.close()
sys.exit(0)
PYEOF
}

start_psp_adhocctl() {
    local bin="$BIN_DIR/pspnet_adhocctl_server"
    [ -x "$bin" ] || { echo "missing $bin"; return 1; }
    ( cd "$UNIFIED_ROOT" && nohup "$bin" >>"$(log_file psp-adhocctl)" 2>&1 & echo $! > "$(pid_file psp-adhocctl)" )
}

start_psp_postoffice() {
    local js="$UNIFIED_ROOT/src/psp/postoffice/aemu_postoffice.js"
    [ -f "$js" ] || { echo "missing $js (run build first)"; return 1; }
    AEMU_POSTOFFICE_CONFIG_PATH="${AEMU_POSTOFFICE_CONFIG_PATH:-$UNIFIED_ROOT/config/postoffice.json}" \
    nohup "$NODE_BIN" "$js" >>"$(log_file psp-postoffice)" 2>&1 &
    echo $! > "$(pid_file psp-postoffice)"
}

start_azahar_room() {
    local bin="$BIN_DIR/azahar-room"
    [ -x "$bin" ] || { echo "missing $bin (run build first)"; return 1; }
    # azahar 参数:--max_members(下划线);首选应用用 --preferred-app/--preferred-app-id
    local args=(--room-name "$AZAHAR_ROOM_NAME" --room-description "$AZAHAR_ROOM_DESCRIPTION"
                --port "$AZAHAR_ROOM_PORT" --max_members "$AZAHAR_ROOM_MAX_MEMBERS"
                --preferred-app "$AZAHAR_ROOM_PREFERRED_GAME"
                --preferred-app-id "$AZAHAR_ROOM_PREFERRED_GAME_ID")
    [ -n "$AZAHAR_ROOM_PASSWORD" ] && args+=(--password "$AZAHAR_ROOM_PASSWORD")
    local api_url="$WEB_API_URL" api_user="$AZAHAR_ROOM_USERNAME" api_token="$AZAHAR_ROOM_TOKEN"
    if [ "$CVN_PLAY_ENABLED" = "true" ] && [ -n "$CVN_PLAY_TOKEN" ]; then
        api_url="$CVN_PLAY_WEB_API_URL"; api_user="$CVN_PLAY_USERNAME"; api_token="$CVN_PLAY_TOKEN"
    fi
    if [ -n "$api_token" ] && [ -n "$api_url" ]; then
        args+=(--username "$api_user" --token "$api_token" --web-api-url "$api_url")
    fi
    args+=(--log-file "$LOG_DIR/azahar-room.log")
    nohup "$bin" "${args[@]}" >>"$(log_file azahar-room)" 2>&1 &
    echo $! > "$(pid_file azahar-room)"
}

start_eden_room() {
    local bin="$BIN_DIR/eden-room"
    [ -x "$bin" ] || { echo "missing $bin (run build first)"; return 1; }
    touch "$DATA_DIR/eden-ban.txt"
    local args=(--room-name "$EDEN_ROOM_NAME" --room-description "$EDEN_ROOM_DESCRIPTION"
                --port "$EDEN_ROOM_PORT" --max-members "$EDEN_ROOM_MAX_MEMBERS"
                --preferred-game "$EDEN_ROOM_PREFERRED_GAME"
                --preferred-game-id "$EDEN_ROOM_PREFERRED_GAME_ID"
                --ban-list-file "$DATA_DIR/eden-ban.txt")
    [ -n "$EDEN_ROOM_PASSWORD" ] && args+=(--password "$EDEN_ROOM_PASSWORD")
    local api_url="$WEB_API_URL" api_user="$EDEN_ROOM_USERNAME" api_token="$EDEN_ROOM_TOKEN"
    if [ "$CVN_PLAY_ENABLED" = "true" ] && [ -n "$CVN_PLAY_TOKEN" ]; then
        api_url="$CVN_PLAY_WEB_API_URL"; api_user="$CVN_PLAY_USERNAME"; api_token="$CVN_PLAY_TOKEN"
    fi
    if [ -n "$api_token" ] && [ -n "$api_url" ]; then
        args+=(--username "$api_user" --token "$api_token" --web-api-url "$api_url")
    fi
    args+=(--log-file "$LOG_DIR/eden-room.log")
    nohup "$bin" "${args[@]}" >>"$(log_file eden-room)" 2>&1 &
    echo $! > "$(pid_file eden-room)"
}

start_webui() {
    local js="$UNIFIED_ROOT/src/webui/server.js"
    [ -f "$js" ] || { echo "missing $js"; return 1; }
    # 自定义界面目录:默认是“运行目录/custom”,不存在则自动生成模板(在目录里放文件即可换界面)
    local custom_dir="${FU_CUSTOM_DIR:-$PWD/custom}"
    if [ ! -d "$custom_dir" ]; then
        mkdir -p "$custom_dir"
        [ -f "$UNIFIED_ROOT/custom/README.txt" ] && cp -f "$UNIFIED_ROOT/custom/README.txt" "$custom_dir/" 2>/dev/null || true
        echo "[webui] 已生成自定义界面目录: $custom_dir (放入 index.html/style.css 即可自定义)"
    fi
    nohup "$NODE_BIN" "$js" --root "$UNIFIED_ROOT" --port "$WEBUI_PORT" --custom-dir "$custom_dir" \
        >>"$(log_file webui)" 2>&1 &
    echo $! > "$(pid_file webui)"
}

start_one() {
    local svc="$1"
    kill_free "$svc"
    sleep 0.3
    if is_running "$svc"; then
        echo "already running: $svc"
        return 0
    fi
    echo "starting $svc ..."
    local fn="start_${svc//-/_}"
    "$fn"
}

stop_one() {
    local svc="$1"
    kill_free "$svc"
    if is_running "$svc"; then
        kill "$(cat "$(pid_file "$svc")")" 2>/dev/null
        for _ in $(seq 1 50); do is_running "$svc" || break; sleep 0.1; done
        if is_running "$svc"; then kill -9 "$(cat "$(pid_file "$svc")")" 2>/dev/null; fi
        echo "stopped $svc"
    else
        echo "not running: $svc"
    fi
    rm -f "$(pid_file "$svc")"
}

action="$1"; svc="${2:-all}"
shift 2>/dev/null || true

case "$action" in
start)
    if [ "$svc" = "all" ]; then for s in $SERVICES; do start_one "$s"; done
    else start_one "$svc"; fi
    ;;
stop)
    if [ "$svc" = "all" ]; then for s in $SERVICES; do stop_one "$s"; done
    else stop_one "$svc"; fi
    ;;
restart)
    if [ "$svc" = "all" ]; then for s in $SERVICES; do stop_one "$s"; done; for s in $SERVICES; do start_one "$s"; done
    else stop_one "$svc"; start_one "$svc"; fi
    ;;
status)
    for s in $SERVICES; do
        if is_running "$s"; then echo "[运行中] $s (pid $(cat "$(pid_file "$s")"))";
        else echo "[已停止] $s"; fi
    done
    echo "---- 端口探测 (房间服务器为 ENet/UDP) ----"
    for entry in "tcp 27312 psp-adhocctl" "tcp 27313 psp-postoffice" \
                 "udp 24872 azahar-room" "udp 24873 eden-room" "tcp 8080 webui"; do
        set -- $entry
        proto="$1"; port="$2"; name="$3"
        if [ "$proto" = "udp" ]; then
            if udp_up "$port"; then echo "  OK  UDP $port ($name)"; else echo "  FAIL UDP $port ($name)"; fi
        else
            if tcp_up "$port"; then echo "  OK  TCP $port ($name)"; else echo "  FAIL TCP $port ($name)"; fi
        fi
    done
    ;;
logs)
    lines="${3:-100}"
    [ -f "$(log_file "$svc")" ] && tail -n "$lines" "$(log_file "$svc")" || echo "no log for $svc"
    ;;
*)
    echo "usage: $0 {start|stop|restart|status|logs} [service]"
    exit 1
    ;;
esac