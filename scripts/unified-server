#!/usr/bin/env bash
# ============================================================
#  大一统服务端 进程管理器
#  用法:
#    scripts/unified-server start [service]
#    scripts/unified-server stop  [service]
#    scripts/unified-server restart [service]
#    scripts/unified-server status
#    scripts/unified-server logs <service> [lines]
#   service: psp-adhocctl | psp-postoffice | azahar-room | eden-room | webui | all
# ============================================================
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# 可被管理面板/外部通过环境变量覆盖
UNIFIED_ROOT="${UNIFIED_ROOT:-$ROOT}"

CONF="${UNIFIED_ROOT}/config/unified-server.conf"
[ -f "$CONF" ] || { echo "config not found: $CONF"; exit 1; }
# shellcheck disable=SC1090
source "$CONF"

RUN_DIR="$UNIFIED_ROOT/data/run"
LOG_DIR="$UNIFIED_ROOT/data/logs"
DATA_DIR="$UNIFIED_ROOT/data"
mkdir -p "$RUN_DIR" "$LOG_DIR" "$DATA_DIR"

BIN_DIR="${BIN_DIR:-$UNIFIED_ROOT/build/bin}"
NODE_BIN="${NODE_BIN:-$(command -v node || echo "$UNIFIED_ROOT/runtime/node/bin/node")}"

[ -x "$NODE_BIN" ] || NODE_BIN="$(command -v node)"

SERVICES="psp-adhocctl psp-postoffice azahar-room eden-room webui"

pid_file()   { echo "$RUN_DIR/$1.pid"; }
log_file()   { echo "$LOG_DIR/$1.log"; }

is_running() {
    [ -f "$(pid_file "$1")" ] || return 1
    pid="$(cat "$(pid_file "$1")" 2>/dev/null)"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

tcp_up() {
    local port="$1"
    timeout 1 bash -c "exec 3<>/dev/tcp/127.0.0.1/$port" 2>/dev/null
}

start_psp_adhocctl() {
    local bin="$BIN_DIR/pspnet_adhocctl_server"
    [ -x "$bin" ] || { echo "missing $bin"; return 1; }
    ( cd "$UNIFIED_ROOT" && nohup "$bin" >>"$(log_file psp-adhocctl)" 2>&1 & echo $! > "$(pid_file psp-adhocctl)" )
}

start_psp_postoffice() {
    local js="$UNIFIED_ROOT/src/psp/postoffice/aemu_postoffice.js"
    [ -f "$js" ] || { echo "missing $js (run build first)"; return 1; }
    AEMU_POSTOFFICE_CONFIG_PATH="${AEMU_POSTOFFICE_CONFIG_PATH:-$UNIFIED_ROOT/config/postoffice.json}" \
    nohup "$NODE_BIN" "$js" >>"$(log_file psp-postoffice)" 2>&1 &
    echo $! > "$(pid_file psp-postoffice)"
}

start_azahar_room() {
    local bin="$BIN_DIR/azahar-room"
    [ -x "$bin" ] || { echo "missing $bin (run build first)"; return 1; }
    local args=(--room-name "$AZAHAR_ROOM_NAME" --room-description "$AZAHAR_ROOM_DESCRIPTION"
                --port "$AZAHAR_ROOM_PORT" --max-members "$AZAHAR_ROOM_MAX_MEMBERS"
                --preferred-game "$AZAHAR_ROOM_PREFERRED_GAME"
                --preferred-game-id "$AZAHAR_ROOM_PREFERRED_GAME_ID")
    [ -n "$AZAHAR_ROOM_PASSWORD" ] && args+=(--password "$AZAHAR_ROOM_PASSWORD")
    if [ -n "$AZAHAR_ROOM_TOKEN" ] && [ -n "$WEB_API_URL" ]; then
        args+=(--username "$AZAHAR_ROOM_USERNAME" --token "$AZAHAR_ROOM_TOKEN" --web-api-url "$WEB_API_URL")
    fi
    args+=(--log-file "$LOG_DIR/azahar-room.log")
    nohup "$bin" "${args[@]}" >>"$(log_file azahar-room)" 2>&1 &
    echo $! > "$(pid_file azahar-room)"
}

start_eden_room() {
    local bin="$BIN_DIR/eden-room"
    [ -x "$bin" ] || { echo "missing $bin (run build first)"; return 1; }
    touch "$DATA_DIR/eden-ban.txt"
    local args=(--room-name "$EDEN_ROOM_NAME" --room-description "$EDEN_ROOM_DESCRIPTION"
                --port "$EDEN_ROOM_PORT" --max-members "$EDEN_ROOM_MAX_MEMBERS"
                --preferred-game "$EDEN_ROOM_PREFERRED_GAME"
                --preferred-game-id "$EDEN_ROOM_PREFERRED_GAME_ID"
                --ban-list-file "$DATA_DIR/eden-ban.txt")
    [ -n "$EDEN_ROOM_PASSWORD" ] && args+=(--password "$EDEN_ROOM_PASSWORD")
    if [ -n "$EDEN_ROOM_TOKEN" ] && [ -n "$WEB_API_URL" ]; then
        args+=(--username "$EDEN_ROOM_USERNAME" --token "$EDEN_ROOM_TOKEN" --web-api-url "$WEB_API_URL")
    fi
    args+=(--log-file "$LOG_DIR/eden-room.log")
    nohup "$bin" "${args[@]}" >>"$(log_file eden-room)" 2>&1 &
    echo $! > "$(pid_file eden-room)"
}

start_webui() {
    local js="$UNIFIED_ROOT/src/webui/server.js"
    [ -f "$js" ] || { echo "missing $js"; return 1; }
    nohup "$NODE_BIN" "$js" --root "$UNIFIED_ROOT" --port "$WEBUI_PORT" \
        >>"$(log_file webui)" 2>&1 &
    echo $! > "$(pid_file webui)"
}

start_one() {
    local svc="$1"
    if is_running "$svc"; then
        echo "already running: $svc"
        return 0
    fi
    echo "starting $svc ..."
    "start_${svc}"
}

stop_one() {
    local svc="$1"
    if is_running "$svc"; then
        kill "$(cat "$(pid_file "$svc")")" 2>/dev/null
        for _ in $(seq 1 50); do is_running "$svc" || break; sleep 0.1; done
        if is_running "$svc"; then kill -9 "$(cat "$(pid_file "$svc")")" 2>/dev/null; fi
        echo "stopped $svc"
    else
        echo "not running: $svc"
    fi
    rm -f "$(pid_file "$svc")"
}

action="$1"; svc="${2:-all}"
shift 2>/dev/null || true

case "$action" in
start)
    if [ "$svc" = "all" ]; then for s in $SERVICES; do start_one "$s"; done
    else start_one "$svc"; fi
    ;;
stop)
    if [ "$svc" = "all" ]; then for s in $SERVICES; do stop_one "$s"; done
    else stop_one "$svc"; fi
    ;;
restart)
    if [ "$svc" = "all" ]; then for s in $SERVICES; do stop_one "$s"; done; for s in $SERVICES; do start_one "$s"; done
    else stop_one "$svc"; start_one "$svc"; fi
    ;;
status)
    for s in $SERVICES; do
        if is_running "$s"; then echo "[运行中] $s (pid $(cat "$(pid_file "$s")"))";
        else echo "[已停止] $s"; fi
    done
    echo "---- 端口探测 ----"
    for entry in "27312 psp-adhocctl" "27313 psp-postoffice" "24872 azahar-room" "24873 eden-room" "8080 webui"; do
        set -- $entry
        if tcp_up "$1"; then echo "  OK  端口 $1 ($2)"; else echo "  FAIL 端口 $1 ($2)"; fi
    done
    ;;
logs)
    lines="${3:-100}"
    [ -f "$(log_file "$svc")" ] && tail -n "$lines" "$(log_file "$svc")" || echo "no log for $svc"
    ;;
*)
    echo "usage: $0 {start|stop|restart|status|logs} [service]"
    exit 1
    ;;
esac